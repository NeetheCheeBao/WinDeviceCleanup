<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.ico"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF0F0F0" Foreground="#FF1A1A1A"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow">

  <Window.Resources>

    <SolidColorBrush x:Key="W32Face"     Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="W32Window"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="W32Text"     Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="W32Gray"     Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="W32Faint"    Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="W32Line"     Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="W32LineSoft" Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="W32BoxBg"    Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="W32Sel"      Color="#FF0078D7"/>
    <SolidColorBrush x:Key="W32SelHover" Color="#FF1A88E0"/>
    <SolidColorBrush x:Key="W32SelPress" Color="#FF0067B8"/>
    <SolidColorBrush x:Key="W32Red"      Color="#FFC0272D"/>
    <SolidColorBrush x:Key="W32Green"    Color="#FF107C10"/>
    <SolidColorBrush x:Key="W32Orange"   Color="#FFB85C00"/>
    <SolidColorBrush x:Key="W32Title"    Color="#FF0B5FA5"/>

    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="#FFF0F0F0"/>
      <Setter Property="Foreground" Value="#FF1A1A1A"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="MinWidth" Value="86"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="#FFDCDCDC" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFE5F1FB"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF9CC7E8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFCCE4F7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF9A9A9A"/>
                <Setter TargetName="bd" Property="Background" Value="#FFF5F5F5"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FFEAEAEA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Background" Value="#FF0078D7"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="#FF0078D7" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF1A88E0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF0067B8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#FFF0F0F0"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FFDCDCDC"/>
                <Setter Property="Foreground" Value="#FF9A9A9A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background" Value="#FFC0272D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="#FFC0272D" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFD63940"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFA31F24"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#FFF0F0F0"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FFDCDCDC"/>
                <Setter Property="Foreground" Value="#FF9A9A9A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF0B5FA5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF1A1A1A"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6D6D6D"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="PlainCheck" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="box" Width="14" Height="14" CornerRadius="1"
                      Background="#FFFFFFFF" BorderBrush="#FF9A9A9A" BorderThickness="1">
                <Path x:Name="tick" Data="M 3 7 L 5.5 9.5 L 11 3.5"
                      Stroke="#FF1A1A1A" StrokeThickness="1.8" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#FFF5F5F5"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#FFF5F5F5">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#FFC8C8C8" BorderBrush="#FFB0B0B0" BorderThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Menu Grid.Row="0" Background="#FFF0F0F0" Padding="2,1">
      <MenuItem Header="选项(_O)">
        <MenuItem x:Name="MiCheckUpdate" Header="检查软件更新(_U)"/>
        <Separator/>
        <MenuItem x:Name="MiOpenLog" Header="打开日志目录(_L)"/>
        <MenuItem x:Name="MiDiagnose" Header="设备查询诊断(_D)"/>
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="#FFF0F0F0" BorderBrush="#FFDCDCDC"
            BorderThickness="0,1,0,1" Padding="8,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="BtnScan"   Content="扫描系统" Style="{StaticResource PrimaryBtn}" Height="28"/>
          <Button x:Name="BtnRemove" Content="移除所选" Style="{StaticResource DangerBtn}"  Height="28"
                  IsEnabled="False" Margin="6,0,0,0"/>
          <Button x:Name="BtnClear"  Content="清空"     Style="{StaticResource ToolBtn}"   Height="28"
                  IsEnabled="False" Margin="6,0,0,0"/>
          <Border Width="1" Background="#FFDCDCDC" Margin="12,2,12,2"/>
          <Button x:Name="BtnSelectAll"  Content="全选"     Style="{StaticResource ToolBtn}" Height="28" MinWidth="66"/>
          <Button x:Name="BtnSelectNone" Content="取消全选" Style="{StaticResource ToolBtn}" Height="28" MinWidth="76" Margin="6,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF9A9A9A"
                   Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusLabel" Text="准备扫描" Style="{StaticResource FieldLabel}"
                     VerticalAlignment="Center" MinWidth="130"/>
          <Border Background="#FFE6E6E6" BorderBrush="#FFDCDCDC"
                  BorderThickness="1" Width="180" Height="14" Margin="8,0,0,0" VerticalAlignment="Center">
            <Border x:Name="ProgressBar" Background="#FF0078D7" Width="0"
                    HorizontalAlignment="Left" Margin="1"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FFF0F0F0" BorderBrush="#FFDCDCDC" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,10,10,10">

            <Border Background="#FFFAFAFA" BorderBrush="#FFDCDCDC" BorderThickness="1" Padding="12,11">
              <StackPanel>
                <TextBlock Text="扫描结果" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="幽灵设备" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="可从注册表移除" Style="{StaticResource HintText}"/>
                <TextBlock x:Name="TxtGhostCount" Text="—" Foreground="#FFC0272D"
                           FontSize="24" FontWeight="Bold" Margin="0,2,0,8"/>

                <Border Height="1" Background="#FFEAEAEA" Margin="0,0,0,8"/>

                <TextBlock Text="受保护" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="已配置 CPU 亲和性" Style="{StaticResource HintText}"/>
                <TextBlock x:Name="TxtProtectedCount" Text="—" Foreground="#FFB85C00"
                           FontSize="24" FontWeight="Bold" Margin="0,2,0,8"/>

                <Border Height="1" Background="#FFEAEAEA" Margin="0,0,0,8"/>

                <TextBlock Text="已移除" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="本次会话" Style="{StaticResource HintText}"/>
                <TextBlock x:Name="TxtRemovedCount" Text="0" Foreground="#FF107C10"
                           FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFAFAFA" BorderBrush="#FFDCDCDC" BorderThickness="1"
                    Padding="12,11" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="说明" Style="{StaticResource SectionTitle}"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" FontSize="11" LineHeight="17">移除先前连接、现已不存在的幽灵设备。降低 IRQ 开销，减少输入延迟，让操作更顺滑。收益随移除数量增加。已配置 CPU 亲和性的设备始终保留。</TextBlock>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Background="#FFFFFFFF">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14,18,10" BorderBrush="#FFEAEAEA" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="检测到的设备" FontSize="18" Foreground="#FF1A1A1A"/>
            <TextBlock x:Name="PageSubtitle" Text="检测 Windows 注册表中已断开连接的设备残留条目"
                       Style="{StaticResource HintText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="DeviceScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,12" Visibility="Collapsed">
          <StackPanel x:Name="DeviceList" Margin="0,12,0,0"/>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" x:Name="EmptyState" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,12">
          <StackPanel MaxWidth="660" HorizontalAlignment="Left" Margin="0,12,0,0">

            <TextBlock Text="关于 WinDeviceCleanup" Style="{StaticResource SectionTitle}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" LineHeight="20">扫描并移除由于曾经连接、现已不存在的硬件在注册表中留下的残留条目（幽灵设备）。这些条目会拖慢设备枚举、在设备管理器中留下「未知设备」，并可能与新接入的硬件产生驱动冲突。</TextBlock>

            <TextBlock Text="工具功能" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="·" Foreground="#FF0B5FA5" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}">检测所有状态为 Unknown（错误代码 45 / CM_PROB_PHANTOM）的设备</TextBlock>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="·" Foreground="#FF0B5FA5" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}">自动保留已配置 CPU 亲和性 / IRQ 绑定的设备，默认不勾选</TextBlock>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="·" Foreground="#FF0B5FA5" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}">三级回退移除：Remove-PnpDevice → pnputil → 注册表</TextBlock>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="·" Foreground="#FF0B5FA5" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}">移除完成后自动重新扫描，确认结果</TextBlock>
              </StackPanel>
            </StackPanel>

            <TextBlock Text="开始使用" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="点击左上角" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <TextBlock Text="「扫描系统」" Foreground="#FF0078D7" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="4,0,0,0"/>
              <TextBlock Text="开始检测，或直接按 F5。" Style="{StaticResource FieldLabel}"
                         VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFCFCFC" BorderBrush="#FFDCDCDC"
                BorderThickness="0,1,0,0" Height="76">
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="1">
            <TextBlock x:Name="LogOutput" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                       Foreground="#FF333333" Padding="18,8"
                       Text="// 就绪。点击「扫描系统」开始检测。"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#FFF0F0F0" BorderBrush="#FFDCDCDC" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="SbMain" Text="就绪" Style="{StaticResource FieldLabel}"
                   Margin="10,4,10,4" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Width="1" Background="#FFDCDCDC" Margin="0,3"/>
        <TextBlock Grid.Column="1" x:Name="SbCount" Text="设备: 0" Style="{StaticResource FieldLabel}"
                   Margin="12,4,12,4" VerticalAlignment="Center" MinWidth="150"/>
      </Grid>
    </Border>
  </Grid>
</Window>